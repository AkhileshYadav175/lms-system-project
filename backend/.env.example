MONGODB_URI=
# REQUIRED: the server refuses to start without JWT_SECRET, ERP_API_KEY and ADMIN_GATEWAY_TOKEN.
# Generate strong values with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional: key used to encrypt the student password copy shown to admins (defaults to one derived from JWT_SECRET).
# Changing it (or JWT_SECRET) means admins must reset a password before it is shown again.
PASSWORD_VIEW_KEY=
FRONTEND_URL=http://localhost:3000

# Cloudinary (legacy: only used to delete old Cloudinary videos; new uploads use R2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_CHUNK_SIZE=

# Cloudflare R2 Configuration for Video Uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jains-lms-videos
R2_ENDPOINT=

# ERP Bridge Configuration
ERP_MODE=http
ERP_BASE_URL=https://erp.jainscomputer.com/api/bridge
ERP_API_KEY=
# Must match NEXT_PUBLIC_ADMIN_GATEWAY_TOKEN in the frontend. It is visible in the browser,
# so it only hides the admin API from scanners; it is not a password.
ADMIN_GATEWAY_TOKEN=


